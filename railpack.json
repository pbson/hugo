{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "hugo": "0.147.0"
  },
  "steps": {
    "build": {
      "inputs": ["...", { "step": "packages:mise", "include": ["/mise", "/usr/local/bin/mise", "/etc/mise/config.toml"] }],
      "variables": { "MISE_DATA_DIR": "/mise" },
      "commands": ["...", { "path": "/mise/shims" }, "hugo --minify --baseURL / --destination public"]
    }
  }
}
